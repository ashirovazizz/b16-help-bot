# Настройки бота. Установщик заполняет токен и код сам.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Код для команды /setup в рабочем чате
SETUP_CODE=

# Утренняя сводка открытых заявок по будням: ЧЧ:ММ или off
DIGEST_TIME=10:00
# Через сколько рабочих дней заявка «в работе» получает пометку ⚠️
SLA_DAYS=3
# Праздники через запятую — в эти дни сводки нет
HOLIDAYS=2026-11-04,2026-12-31
# Через сколько минут напомнить о начатой и неотправленной заявке, 0 — не напоминать
DRAFT_REMIND_MINUTES=30
# Проверка страниц (/pagecheck): через сколько дней напомнить не ответившим (0 — без напоминания)
# и через сколько дней прислать итоги. В команде можно задать свои: /pagecheck 2 5
CHECK_REMIND_DAYS=3
CHECK_CLOSE_DAYS=7
# Страница команды на сайте — её ссылка уходит в проверке
TEAM_PAGE_URL=https://dh.itmo.ru/team
TIMEZONE=Europe/Moscow
LOG_LEVEL=info

# Можно вместо /setup указать чат и тему вручную
OPS_CHAT_ID=
SITE_TOPIC_ID=
