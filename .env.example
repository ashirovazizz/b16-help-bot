# Настройки бота. Скопируйте в .env и заполните. Файл .env не коммитится.

# ── Telegram ─────────────────────────────────────────────
# Токен от @BotFather. Вписывайте прямо сюда, в чат и почту не пересылайте.
TELEGRAM_BOT_TOKEN=
# Рабочий чат и тема «Сайт»: добавьте бота в чат и напишите в теме /id@имя_бота
OPS_CHAT_ID=
OPS_TOPIC_ID=
# Куда слать технические тревоги. Пусто — туда же, в тему «Сайт».
ALERT_CHAT_ID=
ALERT_TOPIC_ID=

# ── Форма ────────────────────────────────────────────────
# Внешний адрес формы (домен, направленный на сервер)
PUBLIC_BASE_URL=https://forms.example.org
# Домен для Caddy: HTTPS-сертификат выпускается автоматически
DOMAIN=forms.example.org
# Секрет для подписи ссылок: openssl rand -base64 48
LINK_SECRET=

# ── Google: аккаунт центра ───────────────────────────────
STORAGE=sheets
# OAuth-клиент типа «Desktop app» из Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Выдаёт npm run google:auth
GOOGLE_REFRESH_TOKEN=
# Выдаёт npm run setup:workbook
SPREADSHEET_ID=
PHOTOS_FOLDER_ID=

# ── Прочее ───────────────────────────────────────────────
SITE_BASE_URL=https://dh.itmo.ru
TIMEZONE=Europe/Moscow
PORT=3000
LOG_LEVEL=info
# Как часто сверять реестр People, минут
REGISTRY_SYNC_MINUTES=5
# Зеркало базового образа, если Docker Hub недоступен
# NODE_IMAGE=mirror.gcr.io/library/node:22-alpine
